<ui:FluentWindow x:Class="ClipEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:local="clr-namespace:ClipEditor"
        Title="Clip Editor" Height="880" Width="950"
        Icon="Assets/AppIcon.ico"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Clip Editor">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="Assets/AppIcon.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:Button Grid.Row="0"
                    Content="Open Video"
                    Width="120" Height="30"
                    Margin="10"
                    HorizontalAlignment="Left"
                    Click="OpenVideo_Click"/>

            <vlc:VideoView Grid.Row="1" x:Name="VideoViewControl" Margin="10"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,10,10,0">
                <ui:Button x:Name="PlayPauseButton" Content="Pause" Width="80" Height="30"
                        Margin="0,0,6,0" Click="PlayPause_Click"/>
                <ui:Button Content="‹" Width="34" Height="30" Margin="0,0,3,0"
                        Click="FrameBack_Click" ToolTip="Previous frame  ( , )"/>
                <ui:Button Content="›" Width="34" Height="30" Margin="0,0,12,0"
                        Click="FrameForward_Click" ToolTip="Next frame  ( . )"/>
                <ui:Button Content="Play Selection" Width="110" Height="30" Margin="0,0,12,0"
                        Click="PlaySelection_Click" ToolTip="Play just the in/out range  ( P )"/>
                <TextBlock x:Name="TimeLabel" Text="0:00 / 0:00" VerticalAlignment="Center"/>
            </StackPanel>

            <local:TrimBar Grid.Row="3" x:Name="TrimTimeline" Margin="12,6,12,0"
                    SeekRequested="TrimTimeline_SeekRequested"
                    ScrubPreview="TrimTimeline_ScrubPreview"
                    InOutChanged="TrimTimeline_InOutChanged"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="12,4,12,0" VerticalAlignment="Center">
                <ui:Button Content="Set In  [" Width="80" Height="28" Click="SetIn_Click"/>
                <TextBlock x:Name="StartLabel" Text="In 0:00.00" VerticalAlignment="Center" Margin="10,0,18,0"/>
                <ui:Button Content="Set Out  ]" Width="86" Height="28" Click="SetOut_Click"/>
                <TextBlock x:Name="EndLabel" Text="Out 0:00.00" VerticalAlignment="Center" Margin="10,0,18,0"/>
                <TextBlock x:Name="SelectionLabel" Text="" VerticalAlignment="Center" Opacity="0.7"/>
            </StackPanel>

            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="10" VerticalAlignment="Center">
                <ui:Button Content="Add Clip" Width="90" Height="30" Click="AddToMontage_Click"/>
                <ui:Button Content="Remove" Width="80" Height="30" Margin="8,0,0,0" Click="RemoveFromMontage_Click"/>
                <ui:Button Content="Clear" Width="70" Height="30" Margin="8,0,0,0" Click="ClearMontage_Click"/>
                <ui:Button Content="↑" Width="34" Height="30" Margin="16,0,0,0"
                        Click="MoveClipUp_Click" ToolTip="Move selected clip earlier"/>
                <ui:Button Content="↓" Width="34" Height="30" Margin="4,0,0,0"
                        Click="MoveClipDown_Click" ToolTip="Move selected clip later"/>
            </StackPanel>

            <ListBox Grid.Row="6" x:Name="MontageListBox" Height="90" Margin="10,0,10,10"/>

            <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="10,0,10,10" VerticalAlignment="Center">
                <TextBlock Text="Target:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="PresetComboBox" Width="200" SelectionChanged="PresetComboBox_SelectionChanged">
                    <ComboBoxItem Content="Discord — 50 MB"/>
                    <ComboBoxItem Content="Discord — 20 MB"/>
                    <ComboBoxItem Content="Full quality (no cap)"/>
                </ComboBox>
                <TextBlock x:Name="SizeEstimateLabel" Text="Estimated size: --"
                           Margin="16,0,0,0" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <ui:Card Grid.Row="8" Margin="10" Padding="10">
                <StackPanel>
                    <TextBlock Text="Export" FontWeight="Bold" Margin="0,0,0,5"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Save to:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="OutputFolderLabel" VerticalAlignment="Center"
                                   Margin="0,0,10,0" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                        <ui:Button Content="Browse…" Height="28" Click="BrowseOutputFolder_Click"/>
                        <ui:Button Content="Reset" Height="28" Margin="8,0,0,0" Click="ResetOutputFolder_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Caption:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="CaptionTextBox" Width="250" Margin="0,0,15,0"/>

                        <CheckBox x:Name="VerticalCropCheckBox" Content="Vertical (9:16 crop)" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="ExportVideoButton" Content="Export as Montage" Width="150" Height="30" Click="ExportMontage_Click"/>
                        <ui:Button x:Name="ExportAudioButton" Content="Export as Audio" Width="140" Height="30" Margin="10,0,0,0" Click="ExportMontageAudio_Click"/>
                    </StackPanel>

                    <StackPanel x:Name="ExportProgressPanel" Orientation="Horizontal"
                                Margin="0,10,0,0" Visibility="Collapsed">
                        <ProgressBar x:Name="ExportProgressBar" Width="240" Height="16"
                                     Minimum="0" Maximum="100" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ExportStatusLabel" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <ui:Button x:Name="CancelExportButton" Content="Cancel" Height="26"
                                   Margin="12,0,0,0" Click="CancelExport_Click"/>
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</ui:FluentWindow>
